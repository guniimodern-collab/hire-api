            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const t = j.token || (j.data && j.data.token) || j.accessToken;",
                  "if (t) pm.collectionVariables.set('hrToken', t);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
